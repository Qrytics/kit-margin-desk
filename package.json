{
  "name": "kit-margin-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "dev:demo": "DEMO_MODE=true react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "tsx worker/index.ts",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "shopify": "shopify"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@react-router/fs-routes": "^7.18.5",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "@shopify/app-bridge-react": "^4.2.14",
    "@shopify/shopify-app-react-router": "^4.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.1",
    "isbot": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
