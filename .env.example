SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.trycloudflare.com
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations,read_fulfillments
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kit_margin_desk
# Set to "true" to run the UI against in-memory demo data (no Shopify, no DB)
DEMO_MODE=false
# Billing runs in test mode unless this is "true"
BILLING_LIVE=false
DIGEST_PROVIDER=console
# webhook mode POSTs {kind,to,subject,text,html} as JSON
DIGEST_WEBHOOK_URL=
DIGEST_WEBHOOK_SECRET=
